{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-sisger-ucb-us-23093"
		},
		"sa_omni_canal_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa_omni_canal\""
		},
		"sql_omni_canal_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_omni_canal\""
		},
		"sa_omni_canal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sasisgerucbventas.dfs.core.windows.net/"
		},
		"sql_omni_canal_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-sisger-ventas3243.database.windows.net"
		},
		"sql_omni_canal_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbventas"
		},
		"sql_omni_canal_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "RaulCastro"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sa_omni_canal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa_omni_canal_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa_omni_canal_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_omni_canal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_omni_canal_properties_typeProperties_server')]",
					"database": "[parameters('sql_omni_canal_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('sql_omni_canal_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql_omni_canal_password')]"
					}
				}
			},
			"dependsOn": []
		},

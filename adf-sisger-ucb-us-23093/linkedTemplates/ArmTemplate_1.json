{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-sisger-ucb-us-23093"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sql_sucursales')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sql_omni_canal",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "sql"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "sucursal_id",
						"type": "varchar"
					},
					{
						"name": "nombre_sucursal",
						"type": "nvarchar"
					},
					{
						"name": "ciudad",
						"type": "nvarchar"
					},
					{
						"name": "zona",
						"type": "nvarchar"
					},
					{
						"name": "formato",
						"type": "nvarchar"
					},
					{
						"name": "fecha_apertura",
						"type": "date"
					}
				],
				"typeProperties": {
					"schema": "ventas_omnicanal",
					"table": "sucursales"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_ventas')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sql_omni_canal",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "sql"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "venta_id",
						"type": "varchar"
					},
					{
						"name": "fecha_venta",
						"type": "date"
					},
					{
						"name": "cliente_id",
						"type": "varchar"
					},
					{
						"name": "sucursal_id",
						"type": "varchar"
					},
					{
						"name": "canal",
						"type": "nvarchar"
					},
					{
						"name": "medio_pago",
						"type": "nvarchar"
					},
					{
						"name": "promocion_id",
						"type": "varchar"
					},
					{
						"name": "estado_venta",
						"type": "nvarchar"
					},
					{
						"name": "total_venta",
						"type": "decimal",
						"precision": 12,
						"scale": 2
					}
				],
				"typeProperties": {
					"schema": "ventas_omnicanal",
					"table": "ventas"
				}
			},
			"dependsOn": []
		}
	]
}
{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-sisger-ucb-us-23093"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sql_ventas')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sql_omni_canal",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "sql"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "venta_id",
						"type": "varchar"
					},
					{
						"name": "fecha_venta",
						"type": "date"
					},
					{
						"name": "cliente_id",
						"type": "varchar"
					},
					{
						"name": "sucursal_id",
						"type": "varchar"
					},
					{
						"name": "canal",
						"type": "nvarchar"
					},
					{
						"name": "medio_pago",
						"type": "nvarchar"
					},
					{
						"name": "promocion_id",
						"type": "varchar"
					},
					{
						"name": "estado_venta",
						"type": "nvarchar"
					},
					{
						"name": "total_venta",
						"type": "decimal",
						"precision": 12,
						"scale": 2
					}
				],
				"typeProperties": {
					"schema": "ventas_omnicanal",
					"table": "ventas"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sucursales_csv')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sa_omni_canal",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "csv"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "sucursales.csv",
						"fileSystem": "raw"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "sucursal_id",
						"type": "String"
					},
					{
						"name": "restaurante_id",
						"type": "String"
					},
					{
						"name": "nombre_sucursal",
						"type": "String"
					},
					{
						"name": "ciudad",
						"type": "String"
					},
					{
						"name": "zona",
						"type": "String"
					},
					{
						"name": "direccion",
						"type": "String"
					},
					{
						"name": "capacidad_mesas",
						"type": "String"
					},
					{
						"name": "tiene_delivery",
						"type": "String"
					}
				]
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_clientes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "clientes_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sql_clientes",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as string,",
						"          segmento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(nombre = initCap(trim(nombre)),",
						"          ciudad = initCap(trim(ciudad)),",
						"          email = lower(trim(email)),",
						"          telefono = trim(telefono),",
						"          fecha_registro = toDate(fecha_registro, 'yyyy-MM-dd')) ~> derivedColumn1",
						"derivedColumn1 split(isNull(cliente_id) || isNull(nombre) || isNull(email) || isNull(ciudad),",
						"     disjoint: false) ~> split1@(rechazados, validos)",
						"split1@validos sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          ciudad as string,",
						"          segmento as string,",
						"          fecha_registro as date,",
						"          edad as integer,",
						"          nivel_fidelidad as string,",
						"          email as string,",
						"          telefono as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          cliente_id,",
						"          nombre,",
						"          ciudad,",
						"          segmento,",
						"          fecha_registro,",
						"          email,",
						"          telefono",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_sucursal')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "sucursales_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sql_sucursales",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          sucursal_id as string,",
						"          restaurante_id as string,",
						"          nombre_sucursal as string,",
						"          ciudad as string,",
						"          zona as string,",
						"          direccion as string,",
						"          capacidad_mesas as string,",
						"          tiene_delivery as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(ciudad = initCap(trim(ciudad)),",
						"          zona = initCap(trim(zona)),",
						"          restaurante_id = trim(restaurante_id)) ~> derivedColumn1",
						"derivedColumn1 split(isNull(sucursal_id) || isNull(nombre_sucursal) || isNull(ciudad) || isNull(restaurante_id),",
						"     disjoint: false) ~> split1@(rechazados, validos)",
						"split1@validos sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          sucursal_id as string,",
						"          nombre_sucursal as string,",
						"          ciudad as string,",
						"          zona as string,",
						"          formato as string,",
						"          fecha_apertura as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          sucursal_id,",
						"          nombre_sucursal,",
						"          ciudad,",
						"          zona,",
						"          formato = capacidad_mesas",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/sucursales_csv')]"
			]
		}
	]
}
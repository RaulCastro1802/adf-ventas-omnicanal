{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-sisger-ucb-us-23093"
		},
		"sa_omni_canal_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa_omni_canal\""
		},
		"sql_omni_canal_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_omni_canal\""
		},
		"sa_omni_canal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sasisgerucbventas.dfs.core.windows.net/"
		},
		"sql_omni_canal_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-sisger-ventas3243.database.windows.net"
		},
		"sql_omni_canal_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbventas"
		},
		"sql_omni_canal_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "RaulCastro"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-sisger-ucb-us-23093_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"sa_omni_canal_accountKey": {
						"value": "[parameters('sa_omni_canal_accountKey')]"
					},
					"sql_omni_canal_password": {
						"value": "[parameters('sql_omni_canal_password')]"
					},
					"sa_omni_canal_properties_typeProperties_url": {
						"value": "[parameters('sa_omni_canal_properties_typeProperties_url')]"
					},
					"sql_omni_canal_properties_typeProperties_server": {
						"value": "[parameters('sql_omni_canal_properties_typeProperties_server')]"
					},
					"sql_omni_canal_properties_typeProperties_database": {
						"value": "[parameters('sql_omni_canal_properties_typeProperties_database')]"
					},
					"sql_omni_canal_properties_typeProperties_userName": {
						"value": "[parameters('sql_omni_canal_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-sisger-ucb-us-23093_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-sisger-ucb-us-23093_ArmTemplate_0')]"
			]
		}
	]
}